rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Sites Rules
    match /sites/{siteId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.keys().hasAll(['name', 'status']) && request.resource.data.name is string && request.resource.data.name.size() <= 100;
      allow update: if isSignedIn(); // Simplified for MVP
      allow delete: if isSignedIn();
    }

    // Laborers Rules
    match /laborers/{laborerId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Logs Rules
    match /logs/{logId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Photos Rules
    match /photos/{photoId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Settings Rules
    match /settings/rates {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
